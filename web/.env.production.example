# ── Arbitrum Sepolia profile ────────────────────────────────────────────────
# Copy to .env.local (overwriting the anvil values) AFTER running the Sepolia
# seed: contracts/script/SeedDemoSepolia.s.sol logs every address to paste here.
NEXT_PUBLIC_CHAIN=arbitrumSepolia
NEXT_PUBLIC_WALLETCONNECT_ID=demo

# ── Account abstraction (gasless passkey onboarding) ─────────────────────────
NEXT_PUBLIC_BUNDLER_URL=
NEXT_PUBLIC_PIMLICO_SPONSORSHIP_POLICY=
NEXT_PUBLIC_GASLESS_CIRCLE=

# Paste these from the SeedDemoSepolia run output:
NEXT_PUBLIC_MXNB=0x
NEXT_PUBLIC_REPUTATION=0x
NEXT_PUBLIC_UNDERWRITER=0x
NEXT_PUBLIC_INSURANCE=0x
NEXT_PUBLIC_FACTORY=0x
NEXT_PUBLIC_DEMO_CIRCLE=0x

# ── AI Underwriter signer key (SERVER-SIDE ONLY) ─────────────────────────────
# UNCHANGED from the anvil profile: the Sepolia seed uses the SAME well-known
# test account #0 as the AI signer (it only signs EIP-712 digests, never needs gas),
# so this value is identical across anvil and Sepolia. The deployer (your funded
# key) is a SEPARATE key supplied only via PRIVATE_KEY at deploy time — never here.
AI_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
