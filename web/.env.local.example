# Copy to .env.local and fill from the SeedDemo / Deploy script output.
# Flip to "arbitrumSepolia" for the testnet demo.
NEXT_PUBLIC_CHAIN=anvil
NEXT_PUBLIC_WALLETCONNECT_ID=demo

NEXT_PUBLIC_MXNB=0x
NEXT_PUBLIC_REPUTATION=0x
NEXT_PUBLIC_UNDERWRITER=0x
NEXT_PUBLIC_INSURANCE=0x
NEXT_PUBLIC_FACTORY=0x
NEXT_PUBLIC_DEMO_CIRCLE=0x

# ── AI Underwriter signer key (SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix) ────
# This private key signs EIP-712 underwriting decisions and risk flags on-chain.
# It must match the aiSigner address passed to the Underwriter contract at deploy time.
#
# For the local anvil demo: the seed script uses anvil account #0 as aiSigner.
# The well-known anvil account #0 private key is:
#   0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# WARNING: This is a public test key. Never use it on mainnet or any real network.
# For production, generate a dedicated signer key and store it in a secrets manager.
#
AI_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
